{
    "site_name": {
        "type": "text",
        "default": null,
        "rules": [
            "nullable",
            "string",
            "max:500"
        ],
        "group": "general",
        "permission": "settings.manage",
        "secret": false
    },
    "site_tagline": {
        "type": "text",
        "default": null,
        "rules": [
            "nullable",
            "string",
            "max:500"
        ],
        "group": "general",
        "permission": "settings.manage",
        "secret": false
    },
    "site_phone": {
        "type": "text",
        "default": null,
        "rules": [
            "nullable",
            "string",
            "max:500"
        ],
        "group": "general",
        "permission": "settings.manage",
        "secret": false
    },
    "site_whatsapp": {
        "type": "text",
        "default": null,
        "rules": [
            "nullable",
            "string",
            "max:500"
        ],
        "group": "general",
        "permission": "settings.manage",
        "secret": false
    },
    "site_address": {
        "type": "text",
        "default": null,
        "rules": [
            "nullable",
            "string",
            "max:500"
        ],
        "group": "general",
        "permission": "settings.manage",
        "secret": false
    },
    "site_email": {
        "type": "text",
        "default": null,
        "rules": [
            "nullable",
            "email",
            "max:254"
        ],
        "group": "general",
        "permission": "settings.manage",
        "secret": false
    },
    "facebook_url": {
        "type": "text",
        "default": null,
        "rules": [
            "nullable",
            "url:http,https",
            "max:2048"
        ],
        "group": "general",
        "permission": "settings.manage",
        "secret": false
    },
    "instagram_url": {
        "type": "text",
        "default": null,
        "rules": [
            "nullable",
            "url:http,https",
            "max:2048"
        ],
        "group": "general",
        "permission": "settings.manage",
        "secret": false
    },
    "tiktok_url": {
        "type": "text",
        "default": null,
        "rules": [
            "nullable",
            "url:http,https",
            "max:2048"
        ],
        "group": "general",
        "permission": "settings.manage",
        "secret": false
    },
    "email_order_confirmation": {
        "type": "boolean",
        "default": true,
        "rules": [
            "required",
            "boolean"
        ],
        "group": "commerce",
        "permission": "settings.manage",
        "secret": false
    },
    "email_account_signup": {
        "type": "boolean",
        "default": true,
        "rules": [
            "required",
            "boolean"
        ],
        "group": "commerce",
        "permission": "settings.manage",
        "secret": false
    },
    "email_forgot_password": {
        "type": "boolean",
        "default": true,
        "rules": [
            "required",
            "boolean"
        ],
        "group": "commerce",
        "permission": "settings.manage",
        "secret": false
    },
    "email_order_update": {
        "type": "boolean",
        "default": true,
        "rules": [
            "required",
            "boolean"
        ],
        "group": "commerce",
        "permission": "settings.manage",
        "secret": false
    },
    "about_text": {
        "type": "text",
        "default": null,
        "rules": [
            "nullable",
            "string",
            "max:20000"
        ],
        "group": "content",
        "permission": "settings.manage",
        "secret": false
    },
    "shipping_policy": {
        "type": "text",
        "default": null,
        "rules": [
            "nullable",
            "string",
            "max:20000"
        ],
        "group": "content",
        "permission": "settings.manage",
        "secret": false
    },
    "returns_policy": {
        "type": "text",
        "default": null,
        "rules": [
            "nullable",
            "string",
            "max:20000"
        ],
        "group": "content",
        "permission": "settings.manage",
        "secret": false
    },
    "privacy_policy": {
        "type": "text",
        "default": null,
        "rules": [
            "nullable",
            "string",
            "max:20000"
        ],
        "group": "content",
        "permission": "settings.manage",
        "secret": false
    },
    "terms_policy": {
        "type": "text",
        "default": null,
        "rules": [
            "nullable",
            "string",
            "max:20000"
        ],
        "group": "content",
        "permission": "settings.manage",
        "secret": false
    },
    "site_city": {
        "type": "text",
        "default": null,
        "rules": [
            "nullable",
            "string",
            "max:100"
        ],
        "group": "general",
        "permission": "settings.manage",
        "secret": false
    },
    "store_currency": {
        "type": "text",
        "default": "PKR",
        "rules": [
            "required",
            "in:PKR,USD,EUR,GBP,AUD,CAD,AED,SAR,INR"
        ],
        "group": "general",
        "permission": "settings.manage",
        "secret": false
    },
    "store_currency_symbol": {
        "type": "text",
        "default": "Rs.",
        "rules": [
            "required",
            "string",
            "max:10"
        ],
        "group": "general",
        "permission": "settings.manage",
        "secret": false
    },
    "store_tax_rate": {
        "type": "text",
        "default": "0.00",
        "rules": [
            "required",
            "numeric",
            "min:0",
            "max:100",
            "decimal:0,2"
        ],
        "group": "general",
        "permission": "settings.manage",
        "secret": false
    },
    "store_country": {
        "type": "text",
        "default": "Pakistan",
        "rules": [
            "required",
            "string",
            "max:100"
        ],
        "group": "general",
        "permission": "settings.manage",
        "secret": false
    },
    "store_country_code": {
        "type": "text",
        "default": "PK",
        "rules": [
            "required",
            "regex:/^[A-Z]{2}$/"
        ],
        "group": "general",
        "permission": "settings.manage",
        "secret": false
    },
    "store_timezone": {
        "type": "text",
        "default": "Asia/Karachi",
        "rules": [
            "required",
            "timezone"
        ],
        "group": "general",
        "permission": "settings.manage",
        "secret": false
    },
    "store_locale": {
        "type": "text",
        "default": "en",
        "rules": [
            "required",
            "in:en"
        ],
        "group": "general",
        "permission": "settings.manage",
        "secret": false
    }
}
