{
    "name": "mavyn/manual-payments",
    "description": "Mavyn manual-payments commerce plugin",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "mavyn/contracts": "^0.1",
        "mavyn/core": "^0.1"
    },
    "autoload": {
        "psr-4": {
            "Mavyn\\ManualPayments\\": "src/"
        }
    },
    "extra": {
        "mavyn": {
            "kind": "plugin",
            "id": "mavyn.manual-payments",
            "name": "Manual Payments",
            "provider": "Mavyn\\ManualPayments\\Plugin",
            "capabilities": [
                "payment.provider"
            ],
            "settings": {
                "payment_cod_enabled": {
                    "type": "boolean",
                    "default": true,
                    "nullable": false,
                    "permission": "settings.manage"
                },
                "payment_easypaisa_enabled": {
                    "type": "boolean",
                    "default": true,
                    "nullable": false,
                    "permission": "settings.manage"
                },
                "payment_jazzcash_enabled": {
                    "type": "boolean",
                    "default": true,
                    "nullable": false,
                    "permission": "settings.manage"
                },
                "payment_bank_transfer_enabled": {
                    "type": "boolean",
                    "default": true,
                    "nullable": false,
                    "permission": "settings.manage"
                },
                "easypaisa_account": {
                    "type": "text",
                    "default": "",
                    "nullable": true,
                    "permission": "settings.manage",
                    "max": 500
                },
                "easypaisa_name": {
                    "type": "text",
                    "default": "",
                    "nullable": true,
                    "permission": "settings.manage",
                    "max": 500
                },
                "jazzcash_account": {
                    "type": "text",
                    "default": "",
                    "nullable": true,
                    "permission": "settings.manage",
                    "max": 500
                },
                "jazzcash_name": {
                    "type": "text",
                    "default": "",
                    "nullable": true,
                    "permission": "settings.manage",
                    "max": 500
                },
                "bank_name": {
                    "type": "text",
                    "default": "",
                    "nullable": true,
                    "permission": "settings.manage",
                    "max": 500
                },
                "bank_title": {
                    "type": "text",
                    "default": "",
                    "nullable": true,
                    "permission": "settings.manage",
                    "max": 500
                },
                "bank_account": {
                    "type": "text",
                    "default": "",
                    "nullable": true,
                    "permission": "settings.manage",
                    "max": 500
                },
                "bank_iban": {
                    "type": "text",
                    "default": "",
                    "nullable": true,
                    "permission": "settings.manage",
                    "max": 500
                }
            }
        }
    }
}
